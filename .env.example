# Copy to .env (never commit .env). Fill in the empty values.

# --- AWS / Bedrock ---------------------------------------------------------
AWS_REGION=ap-south-1
# Option A (simplest): a Bedrock API key
AWS_BEARER_TOKEN_BEDROCK=
# Option B: IAM user keys (leave empty if you use option A)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Models (see docs/SPEC.md section 2)
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_JUDGE_MODEL_ID=global.amazon.nova-2-lite-v1:0
EMBED_DIMENSIONS=1024
# Titan allows 60 requests per minute on a new account; 1 per second stays under it.
EMBED_REQUESTS_PER_SECOND=1

# --- Database --------------------------------------------------------------
# Empty = in-memory store. Port 5434 matches docker-compose.yml.
DATABASE_URL=
# DATABASE_URL=postgresql://semcache:semcache_dev_only@127.0.0.1:5434/semcache

# --- Service ---------------------------------------------------------------
# If set, /admin/* endpoints need the header X-Admin-Token with this value.
ADMIN_TOKEN=

# --- Safety ----------------------------------------------------------------
# Hard stop for live Bedrock spend across all eval runs, in USD.
LIVE_BUDGET_USD=5
